# ---------------------------------------------------------------------------
# VZV CAR SERVIS - konfigurace Apache
# Funguje na klasickem hostingu s AllowOverride All (Apache 2.4).
# Na GitHub Pages / Netlify se ignoruje - tam pouzij soubor "_headers".
# ---------------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

# --- HTTPS + jednotna verze domeny -----------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^vzvcarservis\.cz$ [NC]
  RewriteRule ^ https://www.vzvcarservis.cz%{REQUEST_URI} [R=301,L]
</IfModule>

# --- Bezpecnostni hlavicky -------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # HSTS zapni az po overeni, ze cela domena (vcetne subdomen) funguje na HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

  # Content-Security-Policy - zapnout az po otestovani GTM, reCAPTCHA a Google Maps.
  # Web obsahuje mnoho inline <script> a style atributu, proto je 'unsafe-inline'
  # zatim nutne. I tak CSP blokuje vlozeni skriptu z cizi domeny.
  # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://www.googletagmanager.com https://www.google-analytics.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; frame-src https://www.google.com https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://stats.g.doubleclick.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# --- Zamezit stazeni archivu, zaloh a dokumentace --------------------------
<FilesMatch "\.(zip|md|log|ini|bak|old|sql|env|htpasswd|sh|json)$">
  Require all denied
</FilesMatch>

# --- Cache statickych souboru ---------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/gif                 "access plus 6 months"
  ExpiresByType image/webp                "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/pdf           "access plus 1 week"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# --- Komprese ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Doporuceni pro adresar s nahranymi soubory ----------------------------
# Na produkcnim serveru pridej do /editorweb/filemanager/files/.htaccess:
#   php_flag engine off
#   Options -Indexes
#   <FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|cgi|pl|py|sh|htaccess)$">
#     Require all denied
#   </FilesMatch>
# Tim zabranis spusteni pripadne nahraneho skriptu.
